# Copy to configs/paths.local.yaml (gitignored) and fill in absolute paths.
mvsec:
  root: /home/USER/event-maritime-flow/data/mvsec/hdf5            # <scene>/<seq>_data.hdf5
  gt_flow: /home/USER/event-maritime-flow/data/mvsec/gt_flow      # <scene>/<seq>_gt_flow_dist.npz
  calib: /home/USER/event-maritime-flow/data/mvsec/calib          # <scene>/ (extracted calib zips)
eraft_mvsec_preprocessed: /home/USER/event-maritime-flow/data/eraft/mvsec_outdoor_day_1_20Hz
dsec:
  root: /home/USER/event-maritime-flow/data/dsec                   # <seq>/events_left/{events.h5,rectify_map.h5}, flow/forward/, *_timestamps.txt, calibration/
smd:
  onboard: /home/USER/event-maritime-flow/data/smd/VIS_Onboard
lars:
  root: /home/USER/event-maritime-flow/data/lars                   # {train,val,test}/{images,images_seq,...}; zips in _archives/
v2e:
  repo: /home/USER/event-maritime-flow/external/v2e
  python: /home/USER/event-maritime-flow/external/venvs/v2e/bin/python   # isolated uv venv (D-005)
  slomo_ckpt: /home/USER/event-maritime-flow/external/v2e/input/SuperSloMo39.ckpt
checkpoints:
  eraft_dsec: /home/USER/event-maritime-flow/data/eraft/checkpoints/dsec.tar
  eraft_mvsec20: /home/USER/event-maritime-flow/data/eraft/checkpoints/mvsec_20.tar
outputs:
  events: /home/USER/event-maritime-flow/data/converted   # converted + synthetic event stores (D-018)
  runs: /home/USER/event-maritime-flow/runs
