# Copy to configs/paths.local.yaml (gitignored) and fill in absolute paths.
mvsec:
  root: /data/mvsec                    # *_data.hdf5 files
  gt_flow: /data/mvsec/gt_flow         # *_gt_flow_dist.npz
  calib: /data/mvsec/calib
eraft_mvsec_preprocessed: /data/eraft/mvsec_outdoor_day_1_20Hz
dsec:
  root: /data/dsec                     # <seq>/events_left/{events.h5,rectify_map.h5}, flow/
smd:
  onboard: /data/smd/VIS_Onboard
lars:
  root: /data/lars                     # images/, annotations/, sequences/
v2e:
  repo: /home/USER/event-maritime-flow/external/v2e
  conda_env: v2e
  slomo_ckpt: /home/USER/event-maritime-flow/external/v2e/input/SuperSloMo39.ckpt
checkpoints:
  eraft_dsec: /data/eraft/checkpoints/dsec.tar
  eraft_mvsec20: /data/eraft/checkpoints/mvsec_20.tar
outputs:
  events: /scratch/evflow/events       # converted + synthetic event stores
  runs: /scratch/evflow/runs
